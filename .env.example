# Copy to .env and fill in. Secrets live only in the environment, never in source.

# --- Model (required) — Google Gemini free-tier key ---
GEMINI_API_KEY=
SUAVE_MODEL=gemini-3.1-flash-lite

# --- Images (optional; server-side APIs, free commercial-use licenses) ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Timeout budget, seconds (BUILD.md §3.3) ---
SUAVE_CALL_BUDGET_S=45
SUAVE_MODEL_TIMEOUT_S=25
SUAVE_IMAGE_TIMEOUT_S=8

# --- Vet step (Impeccable detector) ---
SUAVE_VET_ENABLED=true
SUAVE_VET_TIMEOUT_S=10

# --- Payment / x402 (Task Zero — keep OFF until the seller-side settle path is confirmed) ---
# Challenge shape is confirmed (BUILD.md "Task Zero — findings"). The open half is the
# facilitator / gateway that verifies + settles a payment on the seller side. With x402 ON
# and X402_FACILITATOR_URL blank, requests cannot be verified and will 402.
SUAVE_X402_ENABLED=false
SUAVE_PRICE_USDT=0.03
X402_VERSION=1
X402_NETWORK=eip155:196          # X Layer
X402_ASSET=                      # ERC-20 (USDT) contract address to be paid in
X402_ASSET_DECIMALS=6
X402_PAY_TO=                     # Suave's OKX Agentic Wallet address (recipient)
X402_RESOURCE=                   # this endpoint's public https URL
X402_FACILITATOR_URL=            # UNCONFIRMED — the x402 verify/settle facilitator, per OKX

# --- Server ---
PORT=8000

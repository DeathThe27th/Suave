# Copy to .env and fill in. Secrets live only in the environment, never in source.

# --- Model (required) ---
ANTHROPIC_API_KEY=
SUAVE_MODEL=claude-opus-4-8

# --- Images (optional; server-side APIs, free commercial-use licenses) ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Timeout budget, seconds (BUILD.md §3.3) ---
SUAVE_CALL_BUDGET_S=45
SUAVE_MODEL_TIMEOUT_S=25
SUAVE_IMAGE_TIMEOUT_S=8

# --- Vet step (Impeccable detector) ---
SUAVE_VET_ENABLED=true
SUAVE_VET_TIMEOUT_S=10

# --- Payment (Task Zero — keep OFF until the OKX x402 spec is confirmed, BUILD.md §3.2) ---
SUAVE_X402_ENABLED=false
SUAVE_PRICE_USDT=0.03

# --- Server ---
PORT=8000

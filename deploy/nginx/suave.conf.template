# Rendered by bootstrap.sh (envsubst '$DOMAIN') to /etc/nginx/sites-available/suave.conf.
# This is the HTTP-only block; `certbot --nginx` upgrades it to 443 + redirect.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Small requests in, potentially large streamed HTML out.
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MCP / streamed responses: don't buffer, and allow generation headroom
        # (the app self-bounds to ~45s; give the proxy margin above that).
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        # SSE support for a future mounted MCP endpoint.
        proxy_set_header Connection "";
    }
}
